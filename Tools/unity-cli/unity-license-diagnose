      ;;
    --hostaliases-local)
      USE_HOSTALIASES_LOCAL=1
      shift
      ;;
    --override-localdomain)
      [ $# -ge 2 ] || usage
      OVERRIDE_LOCALDOMAIN=$2
      shift 2
      ;;
    --override-res-options)
      [ $# -ge 2 ] || usage
      OVERRIDE_RES_OPTIONS=$2
      shift 2
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage
      ;;
  esac
done

refresh_home_paths

if [ "$USE_TEMP_CLONE" -eq 1 ]; then
  create_temp_clone
fi

if [ "$USE_SANDBOX_HOME" -eq 1 ]; then
  create_sandbox_home
fi

prepare_hostaliases_file

UNITY_VERSION=$(sed -n 's/^m_EditorVersion: //p' "$PROJECT_VERSION_FILE" | head -n 1)
UNITY_EDITOR="/Applications/Unity/Hub/Editor/$UNITY_VERSION/Unity.app/Contents/MacOS/Unity"

if [ ! -x "$UNITY_EDITOR" ]; then
  echo "Unity editor not found: $UNITY_EDITOR" >&2
  exit 1
fi

echo "Probing Unity batchmode licensing for $PROJECT_ROOT_TO_RUN"
echo "Log: $LOG_FILE"
echo "Startup timeout: ${STARTUP_TIMEOUT}s"
echo "Active HOME: $ACTIVE_HOME"
print_identity_summary
print_system_identity_summary
print_host_api_summary
print_resolver_path_summary
print_network_scope_summary
print_env_fallback_summary
print_local_license_summary
print_client_log_evidence
print_process_evidence
print_metrics_db_evidence
print_write_probe_evidence
print_home_db_inventory

rm -f "$LOG_FILE"
trap cleanup_all INT TERM EXIT
ACTIVE_USER_VALUE="${OVERRIDE_USER:-${USER:-}}"
ACTIVE_LOGNAME_VALUE="${LOGNAME:-}"
ACTIVE_HOSTNAME_VALUE="${OVERRIDE_HOSTNAME:-${HOSTNAME:-}}"
ACTIVE_HOSTALIASES_VALUE="${HOSTALIASES_FILE:-${HOSTALIASES:-}}"
ACTIVE_LOCALDOMAIN_VALUE="${OVERRIDE_LOCALDOMAIN:-${LOCALDOMAIN:-}}"
ACTIVE_RES_OPTIONS_VALUE="${OVERRIDE_RES_OPTIONS:-${RES_OPTIONS:-}}"

env HOME="$ACTIVE_HOME" USER="$ACTIVE_USER_VALUE" LOGNAME="$ACTIVE_LOGNAME_VALUE" HOSTNAME="$ACTIVE_HOSTNAME_VALUE" HOSTALIASES="$ACTIVE_HOSTALIASES_VALUE" LOCALDOMAIN="$ACTIVE_LOCALDOMAIN_VALUE" RES_OPTIONS="$ACTIVE_RES_OPTIONS_VALUE" "$UNITY_EDITOR" \
  -batchmode \
  -projectPath "$PROJECT_ROOT_TO_RUN" \
  -quit \
  -logFile "$LOG_FILE" &
UNITY_PID=$!
START_TIME=$(date +%s)

while kill -0 "$UNITY_PID" >/dev/null 2>&1; do
  if log_contains "COMMAND LINE ARGUMENTS:" || log_contains "[Package Manager] Connected to IPC stream" || log_contains "Successfully changed project path to:"; then
    if ! log_contains "Found 0 entitlement groups and 0 free entitlements" \
      && ! log_contains "'com.unity.editor.headless' was not found."; then
      echo "STATUS: startup-ok"
      echo "DETAIL: Unity passed licensing and entered normal batchmode startup."
      wait "$UNITY_PID"
      UNITY_PID=""
      exit 0
    fi
  fi

  NOW=$(date +%s)
  if [ $((NOW - START_TIME)) -ge "$STARTUP_TIMEOUT" ]; then
    break
  fi

  sleep 1
done

STATUS="startup-timeout"
DETAIL="Unity did not reach normal batchmode startup before timeout."

if log_contains "Found 0 entitlement groups and 0 free entitlements"; then
  STATUS="entitlement-missing"
  DETAIL="Licensing returned 0 entitlement groups."
fi

if log_contains "'com.unity.editor.headless' was not found."; then
  STATUS="headless-entitlement-missing"
  DETAIL="Current licensing session does not expose com.unity.editor.headless."
  if license_contains "com.unity.editor.headless"; then
    DETAIL="$DETAIL Local entitlement file still contains it, so the failure is in runtime resolver/session state rather than the cached license XML."
  fi
fi

if log_contains "attempt to write a readonly database"; then
  if [ "$STATUS" = "startup-timeout" ]; then
    STATUS="readonly-database"
    DETAIL="Unity hit a readonly database write during startup."
  else
    DETAIL="$DETAIL Also hit a readonly database write during startup."
  fi

  if metrics_path_not_writable; then
    DETAIL="$DETAIL Metrics path is not writable: $METRICS_DIR"
  fi
fi

echo "STATUS: $STATUS"
echo "DETAIL: $DETAIL"
echo "LOG: $LOG_FILE"
print_log_evidence
print_post_run_home_summary
print_client_failure_summary
print_log_context_summary
print_runtime_log_summary
print_remote_connectivity_summary
print_correlation_summary
exit 1
