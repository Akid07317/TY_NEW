    echo "GLOBAL_DNS_SERVERS: $GLOBAL_DNS_SERVERS"
  else
    echo "GLOBAL_DNS_SERVERS: none"
  fi
  if [ -n "$GLOBAL_DNS_CONFIG_ID" ]; then
    echo "GLOBAL_DNS_CONFIG_ID: $GLOBAL_DNS_CONFIG_ID"
  else
    echo "GLOBAL_DNS_CONFIG_ID: none"
  fi
  if [ -n "$GLOBAL_DNS_CONFIG_SERVICE_ID" ]; then
    echo "GLOBAL_DNS_CONFIG_SERVICE_ID: $GLOBAL_DNS_CONFIG_SERVICE_ID"
  else
    echo "GLOBAL_DNS_CONFIG_SERVICE_ID: none"
