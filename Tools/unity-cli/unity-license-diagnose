  VPN_SERVICE_ID=""
  VPN_SERVICE_SERVERS=""
  VPN_SERVICE_STATE_SERVER_ADDRESS=""
  DNS_SERVICE_IDS=$(scutil <<'EOF' 2>/dev/null
list State:/Network/Service/.*/DNS
EOF
)
  DNS_SERVICE_IDS=$(printf '%s\n' "$DNS_SERVICE_IDS" | sed -n 's/.*State:\/Network\/Service\/\([^/]*\)\/DNS.*/\1/p')
  for service_id in $DNS_SERVICE_IDS; do
