#!/bin/sh
set -eu

usage() {
  cat >&2 <<'EOF'
Usage: Tools/unity-cli/unity-license-diagnose [--log <path>] [--use-temp-clone] [--clone-root <path>] [--startup-timeout <seconds>] [--sandbox-home] [--fresh-sandbox-home] [--keep-temp-clone] [--override-user <name>] [--override-hostname <name>] [--hostaliases-local] [--override-localdomain <value>] [--override-res-options <value>]
EOF
  exit 1
}

PROJECT_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
PROJECT_VERSION_FILE="$PROJECT_ROOT/ProjectSettings/ProjectVersion.txt"
PROJECT_NAME=$(basename "$PROJECT_ROOT")
PROJECT_ROOT_TO_RUN="$PROJECT_ROOT"
USE_TEMP_CLONE=0
CLONE_ROOT="${TMPDIR:-/tmp}"
CLONE_PATH=""
STARTUP_TIMEOUT=20
LOG_FILE="/tmp/${PROJECT_NAME}_license_probe.log"
UNITY_PID=""
USE_SANDBOX_HOME=0
ORIGINAL_HOME="$HOME"
ACTIVE_HOME="$HOME"
LICENSE_FILE=""
PACL_FILE=""
CLIENT_LOG_FILE=""
METRICS_DIR=""
METRICS_DB=""
METRICS_WAL=""
METRICS_SHM=""
TMP_WRITE_PROBE_DIR="${TMPDIR:-/tmp}"
SANDBOX_HOME=""
KEEP_TEMP_CLONE=0
OVERRIDE_USER=""
FRESH_SANDBOX_HOME=0
OVERRIDE_HOSTNAME=""
USE_HOSTALIASES_LOCAL=0
HOSTALIASES_FILE=""
OVERRIDE_LOCALDOMAIN=""
OVERRIDE_RES_OPTIONS=""

if [ ! -f "$PROJECT_VERSION_FILE" ]; then
  echo "ProjectVersion.txt not found: $PROJECT_VERSION_FILE" >&2
  exit 1
fi

create_temp_clone() {
  mkdir -p "$CLONE_ROOT"
  CLONE_PATH=$(mktemp -d "$CLONE_ROOT/${PROJECT_NAME}_license_clone.XXXXXX")

  if ! command -v rsync >/dev/null 2>&1; then
    echo "rsync is required to create a temporary clone for license diagnostics." >&2
    exit 1
  fi

  rsync -a \
    --exclude '.git/' \
    --exclude 'Library/' \
    --exclude 'Logs/' \
    --exclude 'Temp/' \
    --exclude 'obj/' \
    --exclude '.DS_Store' \
    "$PROJECT_ROOT/" "$CLONE_PATH/"

  PROJECT_ROOT_TO_RUN="$CLONE_PATH"
}

refresh_home_paths() {
  LICENSE_FILE="$ACTIVE_HOME/Library/Unity/licenses/UnityEntitlementLicense.xml"
  PACL_FILE="$ACTIVE_HOME/Library/Unity/licenses/packages/packageAccessControlList.xml"
  CLIENT_LOG_FILE="$ACTIVE_HOME/Library/Logs/Unity/Unity.Licensing.Client.log"
  METRICS_DIR="$ACTIVE_HOME/Library/Application Support/Unity"
  METRICS_DB="$ACTIVE_HOME/Library/Application Support/Unity/CoreBusinessMetrics.db"
  METRICS_WAL="$ACTIVE_HOME/Library/Application Support/Unity/CoreBusinessMetrics.db-wal"
  METRICS_SHM="$ACTIVE_HOME/Library/Application Support/Unity/CoreBusinessMetrics.db-shm"
}

create_sandbox_home() {
  SANDBOX_HOME=$(mktemp -d "$TMP_WRITE_PROBE_DIR/${PROJECT_NAME}_unity_home.XXXXXX")
  mkdir -p "$SANDBOX_HOME/Library"
  mkdir -p "$SANDBOX_HOME/Library/Application Support/Unity"

  if [ "$FRESH_SANDBOX_HOME" -eq 0 ] && [ -d "$ORIGINAL_HOME/Library/Unity" ]; then
    cp -R "$ORIGINAL_HOME/Library/Unity" "$SANDBOX_HOME/Library/"
  fi

  if [ "$FRESH_SANDBOX_HOME" -eq 0 ] && [ -f "$ORIGINAL_HOME/Library/Logs/Unity/Unity.Licensing.Client.log" ]; then
    mkdir -p "$SANDBOX_HOME/Library/Logs/Unity"
    cp "$ORIGINAL_HOME/Library/Logs/Unity/Unity.Licensing.Client.log" "$SANDBOX_HOME/Library/Logs/Unity/"
  fi

  ACTIVE_HOME="$SANDBOX_HOME"
  refresh_home_paths
}

cleanup_child() {
  if [ -n "$UNITY_PID" ] && kill -0 "$UNITY_PID" >/dev/null 2>&1; then
    kill "$UNITY_PID" >/dev/null 2>&1 || true
    wait "$UNITY_PID" >/dev/null 2>&1 || true
  fi

  if [ -n "$HOSTALIASES_FILE" ] && [ -f "$HOSTALIASES_FILE" ]; then
    rm -f "$HOSTALIASES_FILE" >/dev/null 2>&1 || true
  fi
}

cleanup_temp_paths() {
  if [ "$KEEP_TEMP_CLONE" -eq 1 ]; then
    [ -n "$CLONE_PATH" ] && echo "Preserved temporary clone: $CLONE_PATH"
    [ -n "$SANDBOX_HOME" ] && echo "Preserved sandbox HOME: $SANDBOX_HOME"
    return 0
  fi

  if [ -n "$CLONE_PATH" ] && [ -d "$CLONE_PATH" ]; then
    rm -rf "$CLONE_PATH" >/dev/null 2>&1 || true
    echo "Removed temporary clone: $CLONE_PATH"
  fi

  if [ -n "$SANDBOX_HOME" ] && [ -d "$SANDBOX_HOME" ]; then
    rm -rf "$SANDBOX_HOME" >/dev/null 2>&1 || true
    echo "Removed sandbox HOME: $SANDBOX_HOME"
  fi
}

cleanup_all() {
  cleanup_child
  cleanup_temp_paths
}

log_contains() {
  PATTERN=$1
  [ -f "$LOG_FILE" ] && grep -F "$PATTERN" "$LOG_FILE" >/dev/null 2>&1
}

license_contains() {
  PATTERN=$1
  [ -f "$LICENSE_FILE" ] && grep -F "$PATTERN" "$LICENSE_FILE" >/dev/null 2>&1
}

extract_last_entitlement_snapshot() {
  SOURCE_FILE=$1

  if [ ! -f "$SOURCE_FILE" ]; then
    return
  fi

  SNAPSHOT_LINE=$(grep -E "Found [0-9]+ entitlement groups and [0-9]+ free entitlements" "$SOURCE_FILE" | tail -n 1 || true)
  if [ -z "$SNAPSHOT_LINE" ]; then
    return
  fi

  ENTITLEMENT_GROUPS=$(printf '%s\n' "$SNAPSHOT_LINE" | sed -E 's/.*Found ([0-9]+) entitlement groups and ([0-9]+) free entitlements.*/\1/')
  FREE_ENTITLEMENTS=$(printf '%s\n' "$SNAPSHOT_LINE" | sed -E 's/.*Found ([0-9]+) entitlement groups and ([0-9]+) free entitlements.*/\2/')

  printf '%s|%s|%s\n' "$ENTITLEMENT_GROUPS" "$FREE_ENTITLEMENTS" "$SNAPSHOT_LINE"
}

print_local_license_summary() {
  if [ -f "$LICENSE_FILE" ]; then
    echo "LOCAL_LICENSE: present ($LICENSE_FILE)"
    if license_contains "com.unity.editor.headless"; then
      echo "LOCAL_HEADLESS: present"
    else
      echo "LOCAL_HEADLESS: missing"
    fi
  else
    echo "LOCAL_LICENSE: missing ($LICENSE_FILE)"
    echo "LOCAL_HEADLESS: unknown"
  fi

  if [ -f "$PACL_FILE" ]; then
    PACL_COUNT=$(grep -c '<Package Id=' "$PACL_FILE" 2>/dev/null || true)
    echo "LOCAL_PACL: present ($PACL_FILE)"
    echo "LOCAL_PACL_PACKAGES: $PACL_COUNT"
  else
    echo "LOCAL_PACL: missing ($PACL_FILE)"
    echo "LOCAL_PACL_PACKAGES: 0"
  fi
}

print_log_evidence() {
  if [ ! -f "$LOG_FILE" ]; then
    return
  fi

  EVIDENCE=$(grep -E "Found [0-9]+ entitlement groups|com\\.unity\\.editor\\.headless|readonly database" "$LOG_FILE" | tail -n 5 || true)
  if [ -n "$EVIDENCE" ]; then
    echo "EVIDENCE:"
    printf '%s\n' "$EVIDENCE"
  fi
}

print_client_log_evidence() {
  if [ ! -f "$CLIENT_LOG_FILE" ]; then
    echo "CLIENT_LOG: missing ($CLIENT_LOG_FILE)"
    return
  fi

  echo "CLIENT_LOG: present ($CLIENT_LOG_FILE)"
  CLIENT_EVIDENCE=$(grep -E "Found [0-9]+ entitlement groups|Successfully parsed license|Skipping download|No ULF license found|Token not found in cache" "$CLIENT_LOG_FILE" | tail -n 8 || true)
  if [ -n "$CLIENT_EVIDENCE" ]; then
    echo "CLIENT_EVIDENCE:"
    printf '%s\n' "$CLIENT_EVIDENCE"
  fi
}

print_process_evidence() {
  echo "PROCESS_EVIDENCE:"

  if ! command -v pgrep >/dev/null 2>&1; then
    echo "pgrep unavailable"
    return
  fi

  PROCESS_OUTPUT_FILE=$(mktemp)
  if pgrep -af "Unity Hub|Unity\\.Licensing\\.Client|Unity\\.app/Contents/MacOS/Unity" >"$PROCESS_OUTPUT_FILE" 2>/dev/null; then
    PROCESS_LINES=$(cat "$PROCESS_OUTPUT_FILE")
    rm -f "$PROCESS_OUTPUT_FILE"
    if [ -n "$PROCESS_LINES" ]; then
      printf '%s\n' "$PROCESS_LINES"
    else
      echo "no-matching-processes"
    fi
  else
    PROCESS_LINES=$(cat "$PROCESS_OUTPUT_FILE" 2>/dev/null || true)
    rm -f "$PROCESS_OUTPUT_FILE"
    if [ -n "$PROCESS_LINES" ]; then
      printf '%s\n' "$PROCESS_LINES"
    else
      echo "process-inspection-unavailable"
    fi
  fi
}

print_metrics_db_evidence() {
  echo "METRICS_DB_EVIDENCE:"

  for TARGET in "$METRICS_DIR" "$METRICS_DB" "$METRICS_WAL" "$METRICS_SHM"; do
    if [ -e "$TARGET" ]; then
      if [ -w "$TARGET" ]; then
        WRITABLE="yes"
      else
        WRITABLE="no"
      fi

      STAT_LINE=$(stat -f 'MODE=%Sp OWNER=%Su GROUP=%Sg PATH=%N' "$TARGET" 2>/dev/null || true)
      if [ -n "$STAT_LINE" ]; then
        echo "$STAT_LINE WRITABLE=$WRITABLE"
      else
        echo "PATH=$TARGET WRITABLE=$WRITABLE"
      fi
    else
      echo "PATH=$TARGET missing"
    fi
  done
}

print_write_probe_evidence() {
  echo "WRITE_PROBE_EVIDENCE:"

  METRICS_PROBE="$METRICS_DIR/.codex_write_probe"
  TMP_PROBE="$TMP_WRITE_PROBE_DIR/codex_write_probe.$$"

  if touch "$TMP_PROBE" >/dev/null 2>&1; then
    echo "TMP_WRITE_PROBE: success ($TMP_PROBE)"
    rm -f "$TMP_PROBE" >/dev/null 2>&1 || true
  else
    echo "TMP_WRITE_PROBE: failed ($TMP_PROBE)"
  fi

  if touch "$METRICS_PROBE" >/dev/null 2>&1; then
    echo "METRICS_WRITE_PROBE: success ($METRICS_PROBE)"
    rm -f "$METRICS_PROBE" >/dev/null 2>&1 || true
  else
    echo "METRICS_WRITE_PROBE: failed ($METRICS_PROBE)"
  fi
}

print_home_db_inventory() {
  echo "HOME_DB_INVENTORY:"

  SEARCH_ROOT="$ACTIVE_HOME/Library"
  if [ ! -d "$SEARCH_ROOT" ]; then
    echo "HOME_DB_SEARCH_ROOT: missing ($SEARCH_ROOT)"
    return
  fi

  DB_INVENTORY=$(find "$SEARCH_ROOT" -maxdepth 5 \
    \( -name '*.db' -o -name '*.db-*' -o -name '*.sqlite' -o -name '*.sqlite-*' -o -name '*.lock' -o -name '*.lck' \) \
    2>/dev/null | sort || true)

  DB_COUNT=$(printf '%s\n' "$DB_INVENTORY" | sed '/^$/d' | wc -l | tr -d ' ')
  echo "HOME_DB_FILE_COUNT: $DB_COUNT"

  if [ -n "$DB_INVENTORY" ]; then
    echo "HOME_DB_FILES:"
    printf '%s\n' "$DB_INVENTORY"
  else
    echo "HOME_DB_FILES: none"
  fi
}

print_identity_summary() {
  echo "IDENTITY_SUMMARY:"
  echo "ORIGINAL_USER: ${USER:-unknown}"
  echo "ORIGINAL_LOGNAME: ${LOGNAME:-unknown}"

  if [ -n "$OVERRIDE_USER" ]; then
    echo "OVERRIDE_USER: $OVERRIDE_USER"
    echo "ACTIVE_USER: $OVERRIDE_USER"
  else
    echo "OVERRIDE_USER: none"
    echo "ACTIVE_USER: ${USER:-unknown}"
  fi

  echo "ACTIVE_LOGNAME: ${LOGNAME:-unknown}"
  if [ -n "$OVERRIDE_HOSTNAME" ]; then
    echo "OVERRIDE_HOSTNAME: $OVERRIDE_HOSTNAME"
  else
    echo "OVERRIDE_HOSTNAME: none"
  fi
  if [ "$USE_HOSTALIASES_LOCAL" -eq 1 ]; then
    echo "HOSTALIASES_LOCAL: enabled"
  else
    echo "HOSTALIASES_LOCAL: disabled"
  fi
  if [ -n "$OVERRIDE_LOCALDOMAIN" ]; then
    echo "OVERRIDE_LOCALDOMAIN: $OVERRIDE_LOCALDOMAIN"
  else
    echo "OVERRIDE_LOCALDOMAIN: none"
  fi
  if [ -n "$OVERRIDE_RES_OPTIONS" ]; then
    echo "OVERRIDE_RES_OPTIONS: $OVERRIDE_RES_OPTIONS"
  else
    echo "OVERRIDE_RES_OPTIONS: none"
  fi
  if [ "$USE_SANDBOX_HOME" -eq 1 ]; then
    if [ "$FRESH_SANDBOX_HOME" -eq 1 ]; then
      echo "SANDBOX_HOME_MODE: fresh"
    else
      echo "SANDBOX_HOME_MODE: copied"
    fi
