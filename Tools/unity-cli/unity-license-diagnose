collect_remote_connectivity_conclusion() {
  URL_CANDIDATES=$(printf '%s\n%s\n' \
    "https://public-cdn.cloud.unity3d.com/config/production" \
    "https://license.unity3d.com/licenses/v1/packages/acl")

  if [ -f "$CLIENT_LOG_FILE" ]; then
    LOG_URLS=$(extract_remote_urls "$CLIENT_LOG_FILE" || true)
    if [ -n "$LOG_URLS" ]; then
      URL_CANDIDATES=$(printf '%s\n%s\n' "$URL_CANDIDATES" "$LOG_URLS")
    fi
  fi

  UNIQUE_URLS=$(printf '%s\n' "$URL_CANDIDATES" | awk 'NF && !seen[$0]++')
  if [ -z "$UNIQUE_URLS" ]; then
    echo "unavailable"
    return
  fi

  URL_COUNT=$(printf '%s\n' "$UNIQUE_URLS" | sed '/^$/d' | wc -l | tr -d ' ')
  REACHABLE_COUNT=0

  while IFS= read -r URL; do
    [ -n "$URL" ] || continue
    if curl -I --max-time 10 -sS "$URL" >/dev/null 2>&1; then
      REACHABLE_COUNT=$((REACHABLE_COUNT + 1))
    fi
  done <<EOF
$UNIQUE_URLS
EOF

  if [ "$URL_COUNT" -gt 0 ] && [ "$REACHABLE_COUNT" -eq "$URL_COUNT" ]; then
    echo "reachable"
  elif [ "$REACHABLE_COUNT" -gt 0 ]; then
    echo "partial"
  else
    echo "failed"
  fi
}

