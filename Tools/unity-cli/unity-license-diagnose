)
    service_ipv4_state=$(scutil <<EOS 2>/dev/null
show State:/Network/Service/$service_id/IPv4
EOS
)
    service_config_method=$(printf '%s\n' "$service_ipv4_setup" | sed -n 's/^[[:space:]]*ConfigMethod : //p' | head -n 1)
    if [ "$service_config_method" = "VPN" ]; then
