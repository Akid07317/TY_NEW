      VPN_SERVICE_STATE_SERVER_ADDRESS=$(printf '%s\n' "$service_ipv4_state" | sed -n 's/^[[:space:]]*ServerAddress : //p' | head -n 1)
      break
    fi
  done
  PRIMARY_SCOPED_NAMESERVER=$(printf '%s\n' "$SCOPED_DNS_OUTPUT" | sed -n 's/.*nameserver\[[0-9][0-9]*\] : //p' | head -n 1)
  if [ -n "$VPN_SERVICE_SERVERS" ] && [ -n "$GLOBAL_DNS_SERVERS" ] && \
     [ "$VPN_SERVICE_SERVERS" = "$GLOBAL_DNS_SERVERS" ] && \
     [ -n "$PRIMARY_SCOPED_NAMESERVER" ] && printf '%s\n' "$VPN_SERVICE_SERVERS" | grep -F "$PRIMARY_SCOPED_NAMESERVER" >/dev/null 2>&1; then
    echo "CORRELATION_EFFECTIVE_DNS_MATCHES_VPN_SERVICE: yes"
  else
    echo "CORRELATION_EFFECTIVE_DNS_MATCHES_VPN_SERVICE: no"
  fi

  if [ "$VPN_SERVICE_STATE_SERVER_ADDRESS" = "127.0.0.1" ] && \
     [ -n "$VPN_SERVICE_SERVERS" ] && [ -n "$GLOBAL_DNS_SERVERS" ] && \
     [ "$VPN_SERVICE_SERVERS" = "$GLOBAL_DNS_SERVERS" ]; then
    echo "CORRELATION_LOOPBACK_VPN_SERVICE_MATCHES_EFFECTIVE_DNS: yes"
  else
    echo "CORRELATION_LOOPBACK_VPN_SERVICE_MATCHES_EFFECTIVE_DNS: no"
  fi

  if metrics_path_not_writable && log_contains "attempt to write a readonly database"; then
    echo "CORRELATION_METRICS_PATH_NOT_WRITABLE_AND_READONLY: yes"
  else
    echo "CORRELATION_METRICS_PATH_NOT_WRITABLE_AND_READONLY: no"
