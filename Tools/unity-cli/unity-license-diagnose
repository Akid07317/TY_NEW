extract_last_matching_line() {
  SOURCE_FILE=$1
  PATTERN=$2

  if [ ! -f "$SOURCE_FILE" ]; then
    return
  fi

  grep -E "$PATTERN" "$SOURCE_FILE" | tail -n 1 || true
}

extract_remote_urls() {
  SOURCE_FILE=$1

  if [ ! -f "$SOURCE_FILE" ]; then
    return
  fi

  python3 - "$SOURCE_FILE" <<'PY'
import pathlib
import re
import sys

path = pathlib.Path(sys.argv[1])
text = path.read_text(errors="ignore")
raw_urls = re.findall(r'https?://[^\s"\'<>]+', text)
urls = sorted({url.rstrip(':.,);') for url in raw_urls})
for url in urls:
    print(url)
PY
}

print_remote_connectivity_summary() {
  echo "REMOTE_CONNECTIVITY_SUMMARY:"

  URL_CANDIDATES=$(printf '%s\n%s\n' \
    "https://public-cdn.cloud.unity3d.com/config/production" \
    "https://license.unity3d.com/licenses/v1/packages/acl")

  if [ -f "$CLIENT_LOG_FILE" ]; then
    LOG_URLS=$(extract_remote_urls "$CLIENT_LOG_FILE" || true)
    if [ -n "$LOG_URLS" ]; then
      URL_CANDIDATES=$(printf '%s\n%s\n' "$URL_CANDIDATES" "$LOG_URLS")
    fi
  fi

  UNIQUE_URLS=$(printf '%s\n' "$URL_CANDIDATES" | awk 'NF && !seen[$0]++')

  if [ -z "$UNIQUE_URLS" ]; then
    echo "REMOTE_URL_COUNT: 0"
    echo "REMOTE_CONNECTIVITY_CONCLUSION: unavailable"
    return
  fi

  URL_COUNT=$(printf '%s\n' "$UNIQUE_URLS" | sed '/^$/d' | wc -l | tr -d ' ')
  echo "REMOTE_URL_COUNT: $URL_COUNT"

  REACHABLE_COUNT=0
  TOTAL_COUNT=0

  while IFS= read -r URL; do
    [ -n "$URL" ] || continue
    TOTAL_COUNT=$((TOTAL_COUNT + 1))
    echo "REMOTE_URL: $URL"

    HOST=$(python3 - "$URL" <<'PY'
import sys
import urllib.parse
print(urllib.parse.urlparse(sys.argv[1]).hostname or "")
PY
)

    if [ -n "$HOST" ]; then
      echo "REMOTE_HOST: $HOST"
    else
      echo "REMOTE_HOST: unavailable"
      continue
    fi

    DNS_RESULT=$(python3 - "$HOST" <<'PY'
import socket
import sys

host = sys.argv[1]
try:
    addrs = sorted({item[4][0] for item in socket.getaddrinfo(host, 443, type=socket.SOCK_STREAM)})
    print("ok|" + ",".join(addrs))
except Exception as exc:
    print("error|" + str(exc))
PY
)

    DNS_STATUS=$(printf '%s\n' "$DNS_RESULT" | cut -d'|' -f1)
    DNS_DETAIL=$(printf '%s\n' "$DNS_RESULT" | cut -d'|' -f2-)
    if [ "$DNS_STATUS" = "ok" ]; then
      echo "REMOTE_DNS: ok ($DNS_DETAIL)"
    else
      echo "REMOTE_DNS: failed ($DNS_DETAIL)"
    fi

    CURL_OUTPUT_FILE=$(mktemp)
    if curl -I --max-time 10 -sS "$URL" >"$CURL_OUTPUT_FILE" 2>&1; then
      HTTP_STATUS_LINE=$(sed -n '1p' "$CURL_OUTPUT_FILE")
      rm -f "$CURL_OUTPUT_FILE"
      if [ -n "$HTTP_STATUS_LINE" ]; then
        echo "REMOTE_HTTP: ok ($HTTP_STATUS_LINE)"
      else
        echo "REMOTE_HTTP: ok (status-line-missing)"
      fi
      REACHABLE_COUNT=$((REACHABLE_COUNT + 1))
    else
      HTTP_ERROR=$(cat "$CURL_OUTPUT_FILE" 2>/dev/null || true)
      rm -f "$CURL_OUTPUT_FILE"
      if [ -n "$HTTP_ERROR" ]; then
        echo "REMOTE_HTTP: failed ($HTTP_ERROR)"
      else
        echo "REMOTE_HTTP: failed (unknown)"
      fi
    fi
  done <<EOF
$UNIQUE_URLS
EOF

  if [ "$URL_COUNT" -gt 0 ] && [ "$REACHABLE_COUNT" -eq "$URL_COUNT" ]; then
    echo "REMOTE_CONNECTIVITY_CONCLUSION: reachable"
  elif [ "$REACHABLE_COUNT" -gt 0 ]; then
    echo "REMOTE_CONNECTIVITY_CONCLUSION: partial"
  else
    echo "REMOTE_CONNECTIVITY_CONCLUSION: failed"
  fi
}

