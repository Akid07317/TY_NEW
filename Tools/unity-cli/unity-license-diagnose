prepare_hostaliases_file() {
  if [ "$USE_HOSTALIASES_LOCAL" -ne 1 ]; then
    return
  fi

  LOCAL_HOSTNAME_VALUE=$(scutil --get LocalHostName 2>/dev/null || true)
  if [ -z "$LOCAL_HOSTNAME_VALUE" ]; then
    return
  fi

  SHORT_HOSTNAME_VALUE=$(hostname 2>/dev/null | sed 's/\..*$//' || true)
  if [ -z "$SHORT_HOSTNAME_VALUE" ]; then
    return
  fi

  HOSTALIASES_FILE=$(mktemp "${TMPDIR:-/tmp}/unity_hostaliases.XXXXXX")
  printf '%s %s.local\n' "$SHORT_HOSTNAME_VALUE" "$LOCAL_HOSTNAME_VALUE" >"$HOSTALIASES_FILE"
}

print_system_identity_summary() {
  echo "SYSTEM_IDENTITY_SUMMARY:"

  HOSTNAME_VALUE=$(hostname 2>/dev/null || true)
  if [ -n "$HOSTNAME_VALUE" ]; then
    echo "SYSTEM_HOSTNAME: $HOSTNAME_VALUE"
  else
    echo "SYSTEM_HOSTNAME: unavailable"
  fi

  COMPUTER_NAME=$(scutil --get ComputerName 2>/dev/null || true)
  if [ -n "$COMPUTER_NAME" ]; then
    echo "SYSTEM_COMPUTER_NAME: $COMPUTER_NAME"
  else
    echo "SYSTEM_COMPUTER_NAME: unavailable"
  fi

  LOCAL_HOSTNAME=$(scutil --get LocalHostName 2>/dev/null || true)
  if [ -n "$LOCAL_HOSTNAME" ]; then
    echo "SYSTEM_LOCAL_HOSTNAME: $LOCAL_HOSTNAME"
  else
    echo "SYSTEM_LOCAL_HOSTNAME: unavailable"
  fi

  HOSTNAME_OUTPUT_FILE=$(mktemp)
  if scutil --get HostName >"$HOSTNAME_OUTPUT_FILE" 2>&1; then
    SYSTEM_HOST_NAME=$(cat "$HOSTNAME_OUTPUT_FILE")
    rm -f "$HOSTNAME_OUTPUT_FILE"
    if [ -n "$SYSTEM_HOST_NAME" ]; then
      echo "SYSTEM_HOST_NAME: $SYSTEM_HOST_NAME"
    else
      echo "SYSTEM_HOST_NAME: empty"
    fi
  else
    SYSTEM_HOST_NAME_ERROR=$(cat "$HOSTNAME_OUTPUT_FILE" 2>/dev/null || true)
    rm -f "$HOSTNAME_OUTPUT_FILE"
    if [ -n "$SYSTEM_HOST_NAME_ERROR" ]; then
      echo "SYSTEM_HOST_NAME_ERROR: $SYSTEM_HOST_NAME_ERROR"
    else
      echo "SYSTEM_HOST_NAME_ERROR: unavailable"
    fi
  fi

  if [ -n "$HOSTNAME_VALUE" ]; then
    HOST_QUERY_OUTPUT=$(dscacheutil -q host -a name "$HOSTNAME_VALUE" 2>/dev/null || true)
    if [ -n "$HOST_QUERY_OUTPUT" ]; then
      FIRST_IP=$(printf '%s\n' "$HOST_QUERY_OUTPUT" | sed -n 's/^ip_address: //p' | head -n 1)
      FIRST_IPV6=$(printf '%s\n' "$HOST_QUERY_OUTPUT" | sed -n 's/^ipv6_address: //p' | head -n 1)
      if [ -n "$FIRST_IP" ]; then
        echo "SYSTEM_HOST_QUERY_IPV4: $FIRST_IP"
      fi
      if [ -n "$FIRST_IPV6" ]; then
        echo "SYSTEM_HOST_QUERY_IPV6: $FIRST_IPV6"
      fi
    else
      echo "SYSTEM_HOST_QUERY: no-match"
    fi
  fi
}

run_with_timeout_capture() {
  TIMEOUT_SECONDS=$1
  shift

  OUTPUT_FILE=$(mktemp)
  "$@" >"$OUTPUT_FILE" 2>&1 &
  CMD_PID=$!
  ELAPSED=0

  while kill -0 "$CMD_PID" >/dev/null 2>&1; do
    if [ "$ELAPSED" -ge "$TIMEOUT_SECONDS" ]; then
      kill "$CMD_PID" >/dev/null 2>&1 || true
      wait "$CMD_PID" >/dev/null 2>&1 || true
      printf '__TIMEOUT__\n'
      cat "$OUTPUT_FILE"
      rm -f "$OUTPUT_FILE"
      return 124
    fi

    sleep 1
    ELAPSED=$((ELAPSED + 1))
  done

  wait "$CMD_PID"
  CMD_RC=$?
  cat "$OUTPUT_FILE"
  rm -f "$OUTPUT_FILE"
  return "$CMD_RC"
}

print_timed_probe_result() {
  FIELD_PREFIX=$1
  shift

  PROBE_FILE=$(mktemp)
  set +e
  "$@" >"$PROBE_FILE" 2>&1
  PROBE_RC=$?
  set -e
  PROBE_OUTPUT=$(cat "$PROBE_FILE")
  rm -f "$PROBE_FILE"
  PROBE_OUTPUT=$(printf '%s\n' "$PROBE_OUTPUT" | sed '/^$/d')

  if [ "$PROBE_RC" -eq 0 ]; then
    echo "${FIELD_PREFIX}_STATUS: ok"
    if [ -n "$PROBE_OUTPUT" ]; then
      echo "${FIELD_PREFIX}_VALUE: $PROBE_OUTPUT"
    else
      echo "${FIELD_PREFIX}_VALUE: empty"
    fi
  elif [ "$PROBE_RC" -eq 124 ]; then
    echo "${FIELD_PREFIX}_STATUS: timeout"
    if [ -n "$PROBE_OUTPUT" ]; then
      echo "${FIELD_PREFIX}_VALUE: $PROBE_OUTPUT"
    else
      echo "${FIELD_PREFIX}_VALUE: timeout"
    fi
  else
    echo "${FIELD_PREFIX}_STATUS: failed"
    if [ -n "$PROBE_OUTPUT" ]; then
      echo "${FIELD_PREFIX}_VALUE: $PROBE_OUTPUT"
    else
      echo "${FIELD_PREFIX}_VALUE: unavailable"
    fi
  fi
}

print_host_api_summary() {
  echo "HOST_API_SUMMARY:"

  print_timed_probe_result "HOST_API_HOSTNAME_F" run_with_timeout_capture 3 hostname -f
  print_timed_probe_result "HOST_API_SCUTIL_HOSTNAME" run_with_timeout_capture 3 scutil --get HostName
  print_timed_probe_result "HOST_API_PY_SOCKET_HOSTNAME" run_with_timeout_capture 3 python3 -c 'import socket; print(socket.gethostname())'
  print_timed_probe_result "HOST_API_PY_SOCKET_FQDN" run_with_timeout_capture 3 python3 -c 'import socket; print(socket.getfqdn())'
}

print_resolver_path_summary() {
  echo "RESOLVER_PATH_SUMMARY:"

  CURRENT_HOSTNAME=$(hostname 2>/dev/null || true)
  CURRENT_HOSTNAME_LOWER=$(printf '%s\n' "$CURRENT_HOSTNAME" | tr '[:upper:]' '[:lower:]')
  SHORT_HOSTNAME_LOWER=$(printf '%s\n' "$CURRENT_HOSTNAME_LOWER" | sed 's/\..*$//')
  LOCAL_HOSTNAME_LOWER=$(scutil --get LocalHostName 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)

  if [ -f /etc/hosts ]; then
    echo "ETC_HOSTS_PRESENT: yes"
    ETC_HOSTS_MATCH_COUNT=0
    if [ -n "$CURRENT_HOSTNAME_LOWER" ]; then
      ETC_HOSTS_MATCH_COUNT=$(rg -n "$CURRENT_HOSTNAME_LOWER" /etc/hosts 2>/dev/null | wc -l | tr -d ' ')
    fi
    echo "ETC_HOSTS_HOSTNAME_MATCHES: $ETC_HOSTS_MATCH_COUNT"
    if [ -n "$LOCAL_HOSTNAME_LOWER" ]; then
      LOCALHOSTNAME_MATCH_COUNT=$(rg -n "$LOCAL_HOSTNAME_LOWER" /etc/hosts 2>/dev/null | wc -l | tr -d ' ')
      echo "ETC_HOSTS_LOCALHOSTNAME_MATCHES: $LOCALHOSTNAME_MATCH_COUNT"
    fi
  else
    echo "ETC_HOSTS_PRESENT: no"
  fi

  SEARCH_DOMAIN=$(scutil --dns 2>/dev/null | sed -n 's/.*search domain\[[0-9][0-9]*\] : //p' | head -n 1)
  if [ -n "$SEARCH_DOMAIN" ]; then
    echo "RESOLVER_SEARCH_DOMAIN: $SEARCH_DOMAIN"
  else
    echo "RESOLVER_SEARCH_DOMAIN: unavailable"
  fi

  LOCAL_RESOLVER_REACH=$(scutil --dns 2>/dev/null | awk '
    /domain   : local/ { in_local = 1; next }
    in_local && /reach/ { print; exit }
    in_local && /^resolver/ { exit }
  ')
  if [ -n "$LOCAL_RESOLVER_REACH" ]; then
    echo "RESOLVER_LOCAL_REACH: $LOCAL_RESOLVER_REACH"
  else
    echo "RESOLVER_LOCAL_REACH: unavailable"
  fi

  if [ -n "$SHORT_HOSTNAME_LOWER" ]; then
    SHORT_HOST_LOOKUP=$(python3 - "$SHORT_HOSTNAME_LOWER" <<'PY'
import subprocess
import sys

name = sys.argv[1]
try:
    proc = subprocess.run(
        ["dscacheutil", "-q", "host", "-a", "name", name],
        capture_output=True,
        text=True,
        timeout=3,
        check=False,
    )
    output = "\n".join(line for line in proc.stdout.splitlines() if line.strip())
    if output:
        print("ok|" + output.replace("\n", " || "))
    else:
        print("empty|")
except subprocess.TimeoutExpired:
    print("timeout|")
except Exception as exc:
    print("error|" + str(exc))
PY
)
    SHORT_HOST_LOOKUP_STATUS=$(printf '%s\n' "$SHORT_HOST_LOOKUP" | cut -d'|' -f1)
    SHORT_HOST_LOOKUP_VALUE=$(printf '%s\n' "$SHORT_HOST_LOOKUP" | cut -d'|' -f2-)
    echo "SHORT_HOST_LOOKUP_STATUS: $SHORT_HOST_LOOKUP_STATUS"
    if [ -n "$SHORT_HOST_LOOKUP_VALUE" ]; then
      echo "SHORT_HOST_LOOKUP_VALUE: $SHORT_HOST_LOOKUP_VALUE"
    else
      echo "SHORT_HOST_LOOKUP_VALUE: empty"
    fi
  fi

  LOCAL_FQDN_LOOKUP=$(python3 - "$CURRENT_HOSTNAME_LOWER" "$LOCAL_HOSTNAME_LOWER" <<'PY'
import subprocess
import sys

hostname = sys.argv[1]
localhostname = sys.argv[2]
targets = []
if hostname:
    targets.append(hostname)
if localhostname:
    targets.append(localhostname + ".local")

for target in targets:
    try:
        proc = subprocess.run(
            ["dscacheutil", "-q", "host", "-a", "name", target],
            capture_output=True,
            text=True,
            timeout=3,
            check=False,
        )
        output = "\n".join(line for line in proc.stdout.splitlines() if line.strip())
        if output:
            print(f"{target}|ok|{output.replace(chr(10), ' || ')}")
        else:
            print(f"{target}|empty|")
    except subprocess.TimeoutExpired:
        print(f"{target}|timeout|")
    except Exception as exc:
        print(f"{target}|error|{exc}")
PY
)
  if [ -n "$LOCAL_FQDN_LOOKUP" ]; then
    echo "LOCAL_NAME_LOOKUPS:"
    printf '%s\n' "$LOCAL_FQDN_LOOKUP"
  else
    echo "LOCAL_NAME_LOOKUPS: unavailable"
  fi
}

print_network_scope_summary() {
  echo "NETWORK_SCOPE_SUMMARY:"

