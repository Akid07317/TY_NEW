  if [ -n "$GLOBAL_DNS_CONFIG_SERVICE_ID" ] && [ -n "$PRIMARY_DOMAIN_SERVICE_ID" ] && \
     [ "$GLOBAL_DNS_CONFIG_SERVICE_ID" = "$PRIMARY_DOMAIN_SERVICE_ID" ] && \
     [ -n "$GLOBAL_DNS_SERVERS" ] && [ -n "$PRIMARY_SERVICE_SERVERS" ] && \
