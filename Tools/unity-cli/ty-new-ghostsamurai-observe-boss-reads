#!/bin/sh
set -eu

usage() {
  cat >&2 <<'EOF'
Usage: Tools/unity-cli/ty-new-ghostsamurai-observe-boss-reads [debug|clean|scene]

Writes a request file that an open Unity GUI can pick up to start the
GhostSamurai Gatekeeper boss-read capture driver in BossTest or another
scene that already contains Boss_Gatekeeper.
EOF
  exit 1
}

MODE=${1:-clean}

case "$MODE" in
  debug)
    REQUEST="bossread-debug"
    ;;
  clean)
    REQUEST="bossread-clean"
    ;;
  scene)
    REQUEST="bossread-scene"
    ;;
  -h|--help)
    usage
    ;;
  *)
    echo "Unknown mode: $MODE" >&2
    usage
    ;;
esac

REQUEST_PATH="/tmp/TY_NEW_boss_read_capture_driver.request"
STAMP=$(date +%s)
printf '%s %s\n' "$REQUEST" "$STAMP" > "$REQUEST_PATH"

cat <<EOF
GhostSamurai boss-read observation request written.
- request: $REQUEST
- stamp: $STAMP
- file: $REQUEST_PATH
- next: keep Unity GUI focused on BossTest or a Gatekeeper scene and wait for the driver to enter Play Mode
EOF
